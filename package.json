{
    "name": "openchamber-context-mode",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "OpenChamber extension: everything context-mode records for OpenCode, per session and across runs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mradwankhalil/openchamber-context-mode-stats.git"
    },
    "openchamber": {
        "apiVersion": 1,
        "engines": {
            "openchamber": ">=2.0.4"
        },
        "contributes": {
            "panel": {
                "id": "context-mode-stats",
                "name": "Context Mode",
                "icon": "icon.svg",
                "entry": "panel/index.html"
            },
            "page": true,
            "statusSection": {
                "entry": "panel/index.html",
                "title": "Context Mode",
                "height": 120
            },
            "service": {
                "entry": "service/main.js",
                "runtime": "host"
            }
        }
    },
    "scripts": {
        "build": "bun run build:panel && bun run build:service",
        "build:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
        "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
        "typecheck": "tsc --noEmit",
        "test": "node --no-warnings --test test/*.test.ts",
        "smoke": "node --no-warnings scripts/smoke.ts",
        "dev": "node --no-warnings dev/server.ts"
    },
    "dependencies": {
        "@openchamber/sdk": "^2.3.3"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "typescript": "^5.9.2"
    }
}
